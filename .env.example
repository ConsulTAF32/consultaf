# Sanity — copiază acest fișier în `.env.local` și completează valorile reale.
# Le găsești în Sanity (sanity.io/manage) după ce creezi proiectul.

NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Secret pentru webhook-ul de reîmprospătare (orice șir aleator; aceeași valoare în Sanity).
SANITY_REVALIDATE_SECRET="random-secret-string"

# Token de scriere — NUMAI pentru scriptul de seed (scripts/create-article.mjs). Opțional.
# SANITY_API_WRITE_TOKEN="..."
